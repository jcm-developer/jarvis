# Copia este fichero a `.dev.vars` para desarrollo local.
# `.dev.vars` está en .gitignore — no se sube nunca.
#
# En producción estos valores van con `wrangler secret put <NOMBRE>`.
# Se ponen una sola vez: los deploys (incluidos los automáticos de Workers Builds)
# no los sobrescriben.

TELEGRAM_BOT_TOKEN="123456789:AA..."
TELEGRAM_WEBHOOK_SECRET="una-cadena-larga-y-aleatoria"

# Tu telegram user id (te lo da @userinfobot). Varios separados por coma.
# Es un secret, no una var, porque el repo es público.
ALLOWED_TELEGRAM_IDS="123456789"

# Fase 1 — clave del proveedor activo (ver LLM_PROVIDER en wrangler.toml).
# https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-..."

# Alternativas ya soportadas:
# GROQ_API_KEY="gsk_..."      https://console.groq.com   (gratis, muy rápido)
# NVIDIA_API_KEY="nvapi-..."  https://build.nvidia.com

# Fase 2 — Supabase. Project Settings → API.
# La service_role key se salta RLS: da acceso total a la base de datos.
# Solo debe existir aquí (local, ignorado por git) y como secret en Cloudflare.
SUPABASE_URL="https://xxxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="eyJ..."
