# Copy this file to `.dev.vars` for local development.
# `.dev.vars` is in .gitignore — it never gets committed.
#
# In production these values go in with `wrangler secret put <NAME>`.
# They are set once: deploys (including Workers Builds' automatic ones) do not
# overwrite them.

TELEGRAM_BOT_TOKEN="123456789:AA..."
TELEGRAM_WEBHOOK_SECRET="a-long-random-string"

# Your telegram user id (@userinfobot gives it to you). Several, comma separated.
# It is a secret and not a var because the repo is public.
ALLOWED_TELEGRAM_IDS="123456789"

# Phase 1 — the active provider's key (see LLM_PROVIDER in wrangler.toml).
# https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-..."

# Alternatives already supported:
# GROQ_API_KEY="gsk_..."      https://console.groq.com   (free, very fast)
# NVIDIA_API_KEY="nvapi-..."  https://build.nvidia.com

# Phase 2 — Supabase. Project Settings → API.
# The service_role key bypasses RLS: it grants full access to the database.
# It should only exist here (local, git-ignored) and as a secret in Cloudflare.
SUPABASE_URL="https://xxxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="eyJ..."

# Phase 6 — Google Calendar, with a service account. Without these three the calendar
# tools answer that it is not configured, the briefing goes out with the tasks only and
# the pre-appointment alert stays quiet: nothing else breaks.
#
# The private key travels with its \n literal, exactly as it comes out of the JSON.
GOOGLE_SA_EMAIL="jarvis@my-project.iam.gserviceaccount.com"
GOOGLE_SA_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# NOT from Google Cloud: it is the calendar you shared with the service account, and its
# id is usually your own email. Never "primary" — that is the service account's own
# calendar, which nobody looks at.
GOOGLE_CALENDAR_ID="you@gmail.com"

# Phase 25 — the voice channel (/voice and /voice/test). Without it both routes answer
# 401, and with VOICE_ENABLED != "true" in wrangler.toml they answer 404 first.
#
# Generate it, never invent it:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
VOICE_API_TOKEN="a-long-random-string"
