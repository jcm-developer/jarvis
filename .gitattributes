# Normalises line endings: always LF in the repo, whatever fits on checkout.
# Prevents whole-file "everything changed" diffs when working from Windows and Linux.
* text=auto eol=lf

# The lockfile is npm's business: do not treat it as a conflict to resolve by hand.
package-lock.json -diff linguist-generated

# Binaries: never convert.
*.png binary
*.jpg binary
*.ico binary
*.woff binary
*.woff2 binary
